<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/drawer" android:layout_width="match_parent" android:layout_height="match_parent"
    android:fitsSystemWindows="true" android:background="#F0EDE6">
    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent"
        android:orientation="vertical" android:background="#F0EDE6">
        <LinearLayout android:layout_width="match_parent" android:layout_height="56dp"
            android:background="#1B3A6B" android:gravity="center_vertical" android:paddingHorizontal="8dp">
            <TextView android:id="@+id/menu" android:layout_width="48dp" android:layout_height="match_parent"
                android:gravity="center" android:text="☰" android:textColor="#FFFFFF" android:textSize="28sp"
                android:contentDescription="القائمة"/>
            <TextView android:id="@+id/title" android:layout_width="0dp" android:layout_height="match_parent"
                android:layout_weight="1" android:gravity="center" android:text="محاسب سوفت"
                android:textColor="#FFFFFF" android:textSize="20sp" android:textStyle="bold"/>
            <TextView android:layout_width="40dp" android:layout_height="match_parent" android:gravity="center"
                android:text="♢" android:textColor="#FFFFFF" android:textSize="24sp"/>
            <TextView android:layout_width="40dp" android:layout_height="match_parent" android:gravity="center"
                android:text="↗" android:textColor="#FFFFFF" android:textSize="23sp"/>
        </LinearLayout>

        <ScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
            android:fillViewport="true">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:paddingTop="8dp">
                <LinearLayout android:id="@+id/quickActions" android:layout_width="match_parent"
                    android:layout_height="112dp" android:gravity="center" android:orientation="horizontal"
                    android:weightSum="4" android:paddingHorizontal="8dp">
                    <LinearLayout android:id="@+id/action_receipt" android:layout_width="0dp" android:layout_height="match_parent"
                        android:layout_weight="1" android:gravity="center" android:orientation="vertical">
                        <TextView android:layout_width="56dp" android:layout_height="56dp" android:gravity="center"
                            android:text="◉" android:textColor="#4A4A4A" android:textSize="42sp"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:background="#1B3A6B"
                            android:paddingHorizontal="16dp" android:paddingVertical="5dp" android:text="قبض/صرف"
                            android:textColor="#FFFFFF" android:textSize="15sp" android:textStyle="bold"/>
                    </LinearLayout>
                    <LinearLayout android:id="@+id/action_sales" android:layout_width="0dp" android:layout_height="match_parent"
                        android:layout_weight="1" android:gravity="center" android:orientation="vertical">
                        <TextView android:layout_width="56dp" android:layout_height="56dp" android:gravity="center"
                            android:text="▾" android:textColor="#4A4A4A" android:textSize="42sp"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:background="#1B3A6B"
                            android:paddingHorizontal="16dp" android:paddingVertical="5dp" android:text="المبيعات"
                            android:textColor="#FFFFFF" android:textSize="15sp" android:textStyle="bold"/>
                        <TextView android:layout_width="32dp" android:layout_height="32dp" android:gravity="center"
                            android:layout_marginTop="-2dp" android:text="+" android:textColor="#FFFFFF" android:textSize="22sp"
                            android:background="#757575"/>
                    </LinearLayout>
                    <LinearLayout android:id="@+id/action_accounts" android:layout_width="0dp" android:layout_height="match_parent"
                        android:layout_weight="1" android:gravity="center" android:orientation="vertical">
                        <TextView android:layout_width="56dp" android:layout_height="56dp" android:gravity="center"
                            android:text="▤" android:textColor="#4A4A4A" android:textSize="38sp"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:background="#1B3A6B"
                            android:paddingHorizontal="16dp" android:paddingVertical="5dp" android:text="الحسابات"
                            android:textColor="#FFFFFF" android:textSize="15sp" android:textStyle="bold"/>
                    </LinearLayout>
                    <LinearLayout android:id="@+id/action_purchases" android:layout_width="0dp" android:layout_height="match_parent"
                        android:layout_weight="1" android:gravity="center" android:orientation="vertical">
                        <TextView android:layout_width="56dp" android:layout_height="56dp" android:gravity="center"
                            android:text="▴" android:textColor="#4A4A4A" android:textSize="42sp"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:background="#1B3A6B"
                            android:paddingHorizontal="16dp" android:paddingVertical="5dp" android:text="المشتريات"
                            android:textColor="#FFFFFF" android:textSize="15sp" android:textStyle="bold"/>
                        <TextView android:layout_width="32dp" android:layout_height="32dp" android:gravity="center"
                            android:layout_marginTop="-2dp" android:text="+" android:textColor="#FFFFFF" android:textSize="22sp"
                            android:background="#757575"/>
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout android:id="@+id/mainMenu" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="vertical" android:background="#1B3A6B">
                    <TextView android:id="@+id/menu_inventory" android:layout_width="match_parent" android:layout_height="52dp"
                        android:gravity="center_vertical|right" android:paddingHorizontal="16dp" android:text="عمليات مخزنية"
                        android:textColor="#FFFFFF" android:textSize="16sp" android:drawableStart="@android:drawable/arrow_down_float"
                        android:drawablePadding="14dp"/>
                    <TextView android:id="@+id/menu_vouchers" android:layout_width="match_parent" android:layout_height="52dp"
                        android:gravity="center_vertical|right" android:paddingHorizontal="16dp" android:text="قيود وحسابات"
                        android:textColor="#FFFFFF" android:textSize="16sp" android:drawableStart="@android:drawable/arrow_down_float"
                        android:drawablePadding="14dp"/>
                    <TextView android:id="@+id/menu_items" android:layout_width="match_parent" android:layout_height="52dp"
                        android:gravity="center_vertical|right" android:paddingHorizontal="16dp" android:text="أصناف"
                        android:textColor="#FFFFFF" android:textSize="16sp" android:drawableStart="@android:drawable/arrow_down_float"
                        android:drawablePadding="14dp"/>
                    <TextView android:id="@+id/menu_currencies" android:layout_width="match_parent" android:layout_height="52dp"
                        android:gravity="center_vertical|right" android:paddingHorizontal="16dp" android:text="العملات"
                        android:textColor="#FFFFFF" android:textSize="16sp" android:drawableStart="@android:drawable/arrow_down_float"
                        android:drawablePadding="14dp"/>
                    <TextView android:id="@+id/menu_reports" android:layout_width="match_parent" android:layout_height="52dp"
                        android:gravity="center_vertical|right" android:paddingHorizontal="16dp" android:text="التقارير"
                        android:textColor="#FFFFFF" android:textSize="16sp" android:drawableStart="@android:drawable/arrow_down_float"
                        android:drawablePadding="14dp"/>
                </LinearLayout>
            </LinearLayout>
        </ScrollView>

        <LinearLayout android:layout_width="match_parent" android:layout_height="60dp"
            android:background="#15305A" android:gravity="center_vertical" android:paddingHorizontal="12dp">
            <TextView android:layout_width="48dp" android:layout_height="48dp" android:gravity="center"
                android:text="▶" android:textColor="#F5C518" android:textSize="25sp"/>
            <TextView android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1"
                android:gravity="center" android:text="المخزن الرئيسي" android:textColor="#FFFFFF" android:textSize="16sp"/>
            <TextView android:layout_width="48dp" android:layout_height="48dp" android:gravity="center"
                android:text="⟳" android:textColor="#FFFFFF" android:textSize="28sp"/>
        </LinearLayout>
    </LinearLayout>

    <LinearLayout android:layout_width="250dp" android:layout_height="match_parent"
        android:layout_gravity="start" android:orientation="vertical" android:background="#FFFFFF">
        <LinearLayout android:layout_width="match_parent" android:layout_height="100dp"
            android:background="#0a6ea9" android:gravity="center">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="@string/app_name" android:textColor="#FFFFFF" android:textSize="20sp" android:textStyle="bold"/>
        </LinearLayout>
        <ListView android:id="@+id/drawerList" android:layout_width="match_parent" android:layout_height="0dp"
            android:layout_weight="1" android:divider="#DCE2EC" android:dividerHeight="1dp" android:choiceMode="singleChoice"/>
    </LinearLayout>
</androidx.drawerlayout.widget.DrawerLayout>